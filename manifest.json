{
	"manifest_version": 3,
	"name": "QuickPaste",
	"version": "2.0",
	"description": "Save text clips from websites as Notes in a Collection",
	"permissions": [
		"storage",
		"contextMenus",
		"notifications",
		"clipboardWrite",
		"offscreen",
		"alarms",
		"scripting"
	],
	"optional_host_permissions": [
		"<all_urls>"
	],
	"icons": {
		"16": "/icons/logo16x16.png",
		"32": "/icons/logo32x32.png",
		"48": "/icons/logo48x48.png",
		"128": "/icons/logo128x128.png"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Alt+Shift+Q",
				"mac": "Alt+Shift+Q"
			}
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"options_page": "options.html",
	"action": {
		"default_icon": {
			"16": "/icons/logo16x16.png",
			"32": "/icons/logo32x32.png",
			"48": "/icons/logo48x48.png",
			"128": "/icons/logo128x128.png"
		},
		"default_popup": "popup.html"
	}
}
